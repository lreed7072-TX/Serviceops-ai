DATABASE_URL="postgresql://fsm_user:fsm_password@localhost:5432/fsm_dev?schema=public"
INVITE_TOKEN_TTL_HOURS=168

# Dev auth bypass (local development ONLY - never set in production/preview)
# Requires NODE_ENV=development to take effect
DEV_AUTH_BYPASS=true
DEV_ORG_ID="your-org-uuid-here"
DEV_USER_ID="your-user-uuid-here"
DEV_ROLE="ADMIN"

# Email Configuration (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="ServiceOpsIQ"

# Anthropic AI (server-side only)
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
SENTRY_DSN="https://your-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
