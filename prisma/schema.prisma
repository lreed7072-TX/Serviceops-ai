generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Limit connections per serverless instance to avoid exhausting the pool
  // directUrl bypasses the pooler for migrations; url goes through PgBouncer
}

enum Role {
  ADMIN
  DISPATCHER
  TECH
  SALES
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ExecutionMode {
  UNIFIED
  MULTI_LANE
}

enum OrderType {
  WORK_ORDER
  SALES_ORDER
  PROJECT
}

enum WorkPackageType {
  MECH_ELEC_UNIFIED
  MECHANICAL
  ELECTRICAL
  CONTROLS
  INSTRUMENTATION
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
}

enum AssetCategory {
  ROTATING_EQUIPMENT
  CONTROLS_AND_ELECTRICAL
  INSTRUMENTATION
  OTHER
}

enum AssetFamily {
  // Rotating Equipment Families
  PUMP
  MOTOR
  GEARBOX
  // Controls & Electrical Families
  CONTROL_PANEL
  ELECTRICAL_FEED_SYSTEM
  // Instrumentation Family
  SENSOR
  // Other
  OTHER
}

enum AssetSubFamily {
  // Pump Sub-Families
  SUBMERSIBLE_WASTEWATER
  VERTICAL_TURBINE
  HORIZONTAL_SPLIT_CASE
  END_SUCTION
  ANSI_API_PROCESS_PUMP
  // Motor Sub-Families
  LOW_VOLTAGE_TEFC_ODP
  MEDIUM_VOLTAGE
  EXPLOSION_PROOF
  // Gearbox Sub-Families
  WORM
  HELICAL
  PLANETARY
  // Control Panel Sub-Families
  UL508A_INDUSTRIAL_PANEL
  PUMP_CONTROL_PANEL
  MCC_BUCKET
  STARTER_VFD
  STARTER_SOFT_STARTER
  STARTER_ACROSS_THE_LINE
  // Instrumentation Sub-Families
  LEVEL
  PRESSURE
  FLOW
  TEMPERATURE
  // Electrical Feed System Sub-Families
  TRANSFORMER
  BREAKER
  DISCONNECT
  FEEDER_SYSTEM
  // Other
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

enum TaskEvidenceType {
  NOTE
  PHOTO
  FILE
}

enum FindingPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PhotoType {
  BEFORE_WORK
  AFTER_WORK
  NAMEPLATE
  DAMAGE
  SAFETY_HAZARD
  MEASUREMENT
  PARTS
  INSTALLATION
  WIRING
  CORROSION
  LEAK
  ALIGNMENT
  GENERAL
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ReportTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ReportBlockType {
  HEADING
  RICH_TEXT
  TABLE
  IMAGE
  TEXT_INPUT
  TEXTAREA
  NUMERIC_INPUT
  YES_NO
  DROPDOWN
  MULTI_SELECT
  DATE_INPUT
  PHOTO_CAPTURE
  SIGNATURE
  GPS_CAPTURE
  SECTION_HEADER
  INSTRUCTIONS
  CALCULATED
}

enum FormResponseStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  EXPORTED
}

// CRM Enums
enum ContactMethod {
  PHONE
  EMAIL
  TEXT
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum CallMethod {
  PHONE
  IN_PERSON
  VIDEO_CALL
  EMAIL
}

enum FollowUpPriority {
  HOT
  NORMAL
  LOW
}

enum FollowUpStatus {
  PENDING
  COMPLETED
}

enum OpportunityStatus {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TicketUrgency {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum TicketStatus {
  OPEN
  ASSIGNED
  CONVERTED
  CLOSED
}

enum CustomerTier {
  A
  B
  C
}

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Company information
  contactEmail String?
  contactPhone String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  country      String?
  website      String?
  taxId        String?

  // Organization preferences
  currency String? @default("USD")
  timezone String? @default("America/Chicago")
  logoUrl  String?

  // Email configuration
  emailFromName    String?
  emailFromAddress String?
  emailReplyTo     String?

  users                  User[]
  invites                Invite[]
  customers              Customer[]
  sites                  Site[]
  assets                 Asset[]
  workOrders             WorkOrder[]
  visits                 Visit[]
  findings               Finding[]
  measures               Measurement[]
  files                  File[]
  fileLinks              FileLink[]
  reports                Report[]
  kbFiles                KbFile[]
  kbChunks               KbChunk[]
  workPackages           WorkPackage[]
  tasks                  TaskInstance[]
  taskEvidence           TaskEvidence[]
  reportTemplates        ReportTemplate[]
  reportBlocks           ReportBlock[]
  timeEntries            TimeEntry[]
  standardsPacks         StandardsPack[]
  standardsPackTasks     StandardsPackTask[]
  measurementDefinitions MeasurementDefinition[]
  taskMeasurements       TaskMeasurement[]
  materials              Material[]
  taskMaterialUsages     TaskMaterialUsage[]
  stockMovements         StockMovement[]
  signatures             Signature[]
  quotes                 Quote[]
  quoteLineItems         QuoteLineItem[]
  invoices               Invoice[]
  invoiceLineItems       InvoiceLineItem[]
  procedureTemplates     ProcedureTemplate[]
  procedureStepTemplates ProcedureStepTemplate[]
  workflowDefinitions    WorkflowDefinition[]
  aiTaskPlans            AITaskPlan[]
  billingConfig          BillingConfig?
  laborRates             LaborRateConfig[]
  customLaborRates       LaborRate[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  taskFindings           TaskFinding[]
  siteCheckIns           SiteCheckIn[]
  workOrderPhotos        WorkOrderPhoto[]
  techPhotos             TechPhoto[]
  qboConnection          QboConnection?
  customerPortalTokens   CustomerPortalToken[]
  formResponses          FormResponse[]

  // CRM relations
  leadSources      LeadSource[]
  callTypes        CallType[]
  callOutcomes     CallOutcome[]
  followUpTypes    FollowUpType[]
  contacts         Contact[]
  callLogs         CallLog[]
  followUps        FollowUp[]
  opportunities    Opportunity[]
  serviceTickets   ServiceTicket[]
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  email     String
  name      String?
  role      Role     @default(TECH)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org                        Org                  @relation(fields: [orgId], references: [id])
  invitesSent                Invite[]             @relation("InviteSentBy")
  assignedVisits             Visit[]              @relation("VisitAssignedTech")
  leadPackages               WorkPackage[]        @relation("WorkPackageLead")
  assignedTasks              TaskInstance[]       @relation("TaskAssignedTo")
  createdTaskEvidence        TaskEvidence[]       @relation("TaskEvidenceCreatedBy")
  createdReportTemplates     ReportTemplate[]     @relation("ReportTemplateCreatedBy")
  updatedReportTemplates     ReportTemplate[]     @relation("ReportTemplateUpdatedBy")
  timeEntries                TimeEntry[]          @relation("TimeEntryUser")
  capturedMeasurements       TaskMeasurement[]    @relation("MeasurementCapturedBy")
  addedMaterialUsages        TaskMaterialUsage[]  @relation("MaterialUsageAddedBy")
  capturedSignatures         Signature[]          @relation("SignatureCapturedBy")
  createdQuotes              Quote[]              @relation("QuoteCreatedBy")
  createdInvoices            Invoice[]            @relation("InvoiceCreatedBy")
  createdProcedureTemplates  ProcedureTemplate[]  @relation("ProcedureTemplateCreatedBy")
  createdWorkflowDefinitions WorkflowDefinition[] @relation("WorkflowDefinitionCreatedBy")
  createdWorkOrders          WorkOrder[]          @relation("WorkOrderCreatedBy")
  approvedAITaskPlans        AITaskPlan[]         @relation("AITaskPlanApprovedBy")
  performedStockMovements    StockMovement[]      @relation("StockMovementPerformedBy")
  notifications              Notification[]       @relation("NotificationUser")
  auditLogs                  AuditLog[]           @relation("AuditLogUser")
  taskFindings               TaskFinding[]        @relation("TaskFindingCreatedBy")
  siteCheckIns               SiteCheckIn[]        @relation("SiteCheckInUser")
  uploadedPhotos             WorkOrderPhoto[]     @relation("PhotoUploadedBy")
  techPhotos                 TechPhoto[]          @relation("TechPhotoUser")
  filledFormResponses        FormResponse[]       @relation("FilledFormResponses")

  // CRM relations
  createdContacts            Contact[]            @relation("ContactCreatedBy")
  callLogs                   CallLog[]            @relation("CallLogUser")
  assignedFollowUps          FollowUp[]           @relation("FollowUpAssignedTo")
  createdFollowUps           FollowUp[]           @relation("FollowUpCreatedBy")
  createdOpportunities       Opportunity[]        @relation("OpportunityCreatedBy")
  createdServiceTickets      ServiceTicket[]      @relation("ServiceTicketCreatedBy")
  assignedCustomers          Customer[]           @relation("CustomerAssignedTo")
  createdCustomers           Customer[]           @relation("CustomerCreatedBy")

  @@unique([orgId, email])
  @@index([orgId])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Org   @relation(fields: [orgId], references: [id])
  invitedBy User? @relation("InviteSentBy", fields: [invitedById], references: [id])

  @@index([orgId])
  @@index([orgId, email])
}

model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @db.Uuid
  name              String
  status            String   @default("ACTIVE")
  primaryEmail      String?
  primaryPhone      String?
  billingAddress    String?
  billingStreet1    String?
  billingStreet2    String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String?
  notes             String?
  qboCustomerId     String? // QuickBooks customer ID

  // CRM fields
  tier              CustomerTier?
  leadSourceId      String?        @db.Uuid
  assignedToUserId  String?        @db.Uuid
  createdByUserId   String?        @db.Uuid

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org          Org                   @relation(fields: [orgId], references: [id])
  sites        Site[]
  assets       Asset[]
  workOrders   WorkOrder[]
  quotes       Quote[]
  invoices     Invoice[]
  pmSchedules  WorkflowDefinition[]  @relation("PMScheduleCustomer")
  portalTokens CustomerPortalToken[]

  // CRM relations
  leadSource        LeadSource?    @relation(fields: [leadSourceId], references: [id])
  assignedTo        User?          @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy         User?          @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  contacts          Contact[]
  callLogs          CallLog[]
  followUps         FollowUp[]
  opportunities     Opportunity[]
  serviceTickets    ServiceTicket[]

  @@index([orgId])
  @@index([orgId, name])
}

model Site {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  customerId String   @db.Uuid
  name       String
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org           Org                  @relation(fields: [orgId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])
  assets        Asset[]
  workOrders    WorkOrder[]
  quotes        Quote[]
  invoices      Invoice[]
  pmSchedules   WorkflowDefinition[] @relation("PMScheduleSite")
  formResponses FormResponse[]

  // CRM relations
  callLogs          CallLog[]
  followUps         FollowUp[]
  opportunities     Opportunity[]
  serviceTickets    ServiceTicket[]

  @@index([orgId])
  @@index([orgId, customerId])
  @@index([orgId, name])
}

model Asset {
  id                     String            @id @default(uuid()) @db.Uuid
  orgId                  String            @db.Uuid
  customerId             String            @db.Uuid
  siteId                 String            @db.Uuid
  name                   String
  manufacturer           String?
  model                  String?
  serialNumber           String?
  assetTag               String?
  assetCategory          AssetCategory?
  assetFamily            AssetFamily?
  assetSubFamily         AssetSubFamily?
  location               String?
  notes                  String?
  status                 AssetStatus       @default(ACTIVE)
  criticality            AssetCriticality?
  nameplateSchemaVersion Int               @default(1)
  nameplate              Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  org           Org                  @relation(fields: [orgId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])
  site          Site                 @relation(fields: [siteId], references: [id])
  workOrders    WorkOrder[]
  pmSchedules   WorkflowDefinition[] @relation("PMScheduleAsset")
  formResponses FormResponse[]

  @@index([orgId])
  @@index([orgId, siteId])
  @@index([orgId, customerId])
  @@index([orgId, name])
  @@index([serialNumber])
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  customerId       String          @db.Uuid
  siteId           String          @db.Uuid
  assetId          String?         @db.Uuid
  quoteId          String?         @db.Uuid // Optional - work order created from accepted quote
  title            String
  description      String?
  status           WorkOrderStatus @default(OPEN)
  executionMode    ExecutionMode   @default(UNIFIED)
  orderType        OrderType       @default(WORK_ORDER)
  workOrderNumber  String?
  priority         String? // LOW, MEDIUM, HIGH, CRITICAL
  dueDate          DateTime?
  completedAt      DateTime?
  estimatedHours   Float?
  createdByUserId  String?         @db.Uuid
  sourceWorkflowId String?         @db.Uuid // PM schedule that generated this WO
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org            Org                  @relation(fields: [orgId], references: [id])
  customer       Customer             @relation(fields: [customerId], references: [id])
  site           Site                 @relation(fields: [siteId], references: [id])
  asset          Asset?               @relation(fields: [assetId], references: [id])
  quote          Quote?               @relation(fields: [quoteId], references: [id])
  createdByUser  User?                @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id])
  sourceWorkflow WorkflowDefinition?  @relation("PMGeneratedWOs", fields: [sourceWorkflowId], references: [id])
  visits         Visit[]
  packages       WorkPackage[]
  tasks          TaskInstance[]
  timeEntries    TimeEntry[]
  signatures     Signature[]
  invoices       Invoice[]
  aiTaskPlans    AITaskPlan[]
  pmLastGenFor   WorkflowDefinition[] @relation("PMLastGeneratedWO")
  siteCheckIns   SiteCheckIn[]
  photos         WorkOrderPhoto[]
  techPhotos     TechPhoto[]
  formResponses  FormResponse[]

  // CRM relations
  serviceTicketSource ServiceTicket? @relation("TicketWorkOrder")

  @@unique([orgId, workOrderNumber])
  @@index([orgId])
  @@index([orgId, customerId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([siteId])
}

model WorkPackage {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  workOrderId String          @db.Uuid
  packageType WorkPackageType
  name        String
  status      String          @default("PLANNED")
  leadTechId  String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  org       Org            @relation(fields: [orgId], references: [id])
  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id])
  leadTech  User?          @relation("WorkPackageLead", fields: [leadTechId], references: [id])
  tasks     TaskInstance[]

  @@index([orgId])
  @@index([orgId, workOrderId])
}

model TaskInstance {
  id               String     @id @default(uuid()) @db.Uuid
  orgId            String     @db.Uuid
  workOrderId      String     @db.Uuid
  workPackageId    String     @db.Uuid
  title            String
  description      String?
  status           TaskStatus @default(TODO)
  sequenceNumber   Int?
  assignedToId     String?    @db.Uuid
  isCritical       Boolean    @default(false)
  requiresEvidence Boolean    @default(false)
  blockedById      String?    @db.Uuid // Task that must complete before this one
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  org                    Org                     @relation(fields: [orgId], references: [id])
  workOrder              WorkOrder               @relation(fields: [workOrderId], references: [id])
  workPackage            WorkPackage             @relation(fields: [workPackageId], references: [id])
  assignedTo             User?                   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  blockedBy              TaskInstance?           @relation("TaskDependency", fields: [blockedById], references: [id], onDelete: SetNull)
  blockingTasks          TaskInstance[]          @relation("TaskDependency")
  evidence               TaskEvidence[]
  timeEntries            TimeEntry[]
  measurements           TaskMeasurement[]
  materialUsages         TaskMaterialUsage[]
  invoiceLineItems       InvoiceLineItem[]
  measurementDefinitions MeasurementDefinition[]
  findings               TaskFinding[]

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([orgId, workPackageId])
  @@index([blockedById])
  @@index([orgId, status])
}

model TaskEvidence {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @db.Uuid
  taskInstanceId  String           @db.Uuid
  type            TaskEvidenceType
  noteText        String?
  url             String?
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())

  org           Org          @relation(fields: [orgId], references: [id])
  taskInstance  TaskInstance @relation(fields: [taskInstanceId], references: [id])
  createdByUser User         @relation("TaskEvidenceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, taskInstanceId])
  @@index([orgId, createdByUserId])
}

model Visit {
  id             String      @id @default(uuid()) @db.Uuid
  orgId          String      @db.Uuid
  workOrderId    String      @db.Uuid
  assignedTechId String?     @db.Uuid
  status         VisitStatus @default(PLANNED)
  visitNumber    String?
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  summary        String?
  outcome        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  org          Org           @relation(fields: [orgId], references: [id])
  workOrder    WorkOrder     @relation(fields: [workOrderId], references: [id])
  assignedTech User?         @relation("VisitAssignedTech", fields: [assignedTechId], references: [id])
  findings     Finding[]
  measures     Measurement[]
  files        File[]
  reports      Report[]

  @@unique([orgId, visitNumber])
  @@index([orgId])
  @@index([orgId, workOrderId])
}

model Finding {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  visitId   String   @db.Uuid
  category  String
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org   @relation(fields: [orgId], references: [id])
  visit Visit @relation(fields: [visitId], references: [id])

  @@index([orgId])
  @@index([orgId, visitId])
}

model Measurement {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  visitId   String   @db.Uuid
  name      String
  value     String
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org   @relation(fields: [orgId], references: [id])
  visit Visit @relation(fields: [visitId], references: [id])

  @@index([orgId])
  @@index([orgId, visitId])
}

model File {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  visitId    String?  @db.Uuid
  reportId   String?  @db.Uuid
  kbFileId   String?  @db.Uuid
  filename   String
  mimeType   String
  storageKey String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id])
  visit  Visit?  @relation(fields: [visitId], references: [id])
  report Report? @relation(fields: [reportId], references: [id])
  kbFile KbFile? @relation(fields: [kbFileId], references: [id])

  links FileLink[]

  @@index([orgId])
  @@index([orgId, visitId])
}

model FileLink {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  fileId     String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  label      String?
  createdAt  DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id])
  file File @relation(fields: [fileId], references: [id])

  @@unique([orgId, fileId, entityType, entityId])
  @@index([orgId])
  @@index([orgId, entityType, entityId])
  @@index([orgId, fileId])
}

model Report {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  visitId   String   @db.Uuid
  title     String
  status    String   @default("DRAFT")
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org    @relation(fields: [orgId], references: [id])
  visit Visit  @relation(fields: [visitId], references: [id])
  files File[]

  @@index([orgId])
  @@index([orgId, visitId])
}

model ReportTemplate {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @db.Uuid
  name            String
  description     String?
  status          ReportTemplateStatus @default(DRAFT)
  schemaVersion   Int                  @default(1)
  definition      Json
  createdByUserId String               @db.Uuid
  updatedByUserId String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  org           Org            @relation(fields: [orgId], references: [id])
  createdByUser User           @relation("ReportTemplateCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?          @relation("ReportTemplateUpdatedBy", fields: [updatedByUserId], references: [id])
  blocks        ReportBlock[]  @relation("ReportTemplateBlocks")
  formResponses FormResponse[]

  @@index([orgId])
  @@index([orgId, status])
}

model ReportBlock {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  reportTemplateId String          @db.Uuid
  type             ReportBlockType
  title            String?
  props            Json
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org            Org            @relation(fields: [orgId], references: [id])
  reportTemplate ReportTemplate @relation("ReportTemplateBlocks", fields: [reportTemplateId], references: [id])

  @@index([orgId])
  @@index([orgId, reportTemplateId])
  @@index([orgId, reportTemplateId, sortOrder])
}

model KbFile {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  title     String
  sourceUrl String?
  category  String?
  tags      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org       @relation(fields: [orgId], references: [id])
  files  File[]
  chunks KbChunk[]

  @@index([orgId])
}

model KbChunk {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  kbFileId   String   @db.Uuid
  content    String
  tokenCount Int?
  embedding  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org    Org    @relation(fields: [orgId], references: [id])
  kbFile KbFile @relation(fields: [kbFileId], references: [id])

  @@index([orgId])
  @@index([orgId, kbFileId])
}

enum TimeEntryStatus {
  RUNNING
  PAUSED
  STOPPED
}

model TimeEntry {
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @db.Uuid
  userId             String          @db.Uuid
  workOrderId        String          @db.Uuid
  taskInstanceId     String?         @db.Uuid
  status             TimeEntryStatus @default(RUNNING)
  startedAt          DateTime        @default(now())
  pausedAt           DateTime?
  stoppedAt          DateTime?
  // Accumulated seconds before current running segment
  accumulatedSeconds Int             @default(0)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  org          Org           @relation(fields: [orgId], references: [id])
  user         User          @relation("TimeEntryUser", fields: [userId], references: [id])
  workOrder    WorkOrder     @relation(fields: [workOrderId], references: [id])
  taskInstance TaskInstance? @relation(fields: [taskInstanceId], references: [id])

  @@index([orgId])
  @@index([orgId, userId])
  @@index([orgId, workOrderId])
  @@index([orgId, taskInstanceId])
  @@index([userId, status])
}

model user_org_roles {
  user_id String @db.Uuid
  org_id  String @db.Uuid
  role    String

  @@id([user_id, org_id])
  @@index([user_id])
}

// ============================================
// STANDARDS PACKS - Reusable Task Templates
// ============================================

enum StandardsPackStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model StandardsPack {
  id             String              @id @default(uuid()) @db.Uuid
  orgId          String              @db.Uuid
  name           String
  description    String?
  equipmentType  String? // e.g., "Centrifugal Pump", "Control Valve"
  status         StandardsPackStatus @default(DRAFT)
  estimatedHours Float? // Total estimated hours for all tasks
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  org                Org                 @relation(fields: [orgId], references: [id])
  tasks              StandardsPackTask[]
  procedureTemplates ProcedureTemplate[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, equipmentType])
}

model StandardsPackTask {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  standardsPackId  String          @db.Uuid
  title            String
  description      String?
  packageType      WorkPackageType @default(MECH_ELEC_UNIFIED)
  sequenceNumber   Int             @default(0)
  isCritical       Boolean         @default(false)
  requiresEvidence Boolean         @default(false)
  estimatedMinutes Int? // Estimated time for this task
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org                    Org                     @relation(fields: [orgId], references: [id])
  standardsPack          StandardsPack           @relation(fields: [standardsPackId], references: [id], onDelete: Cascade)
  measurementDefinitions MeasurementDefinition[]

  @@index([orgId])
  @@index([orgId, standardsPackId])
  @@index([standardsPackId, sequenceNumber])
}

// ============================================
// MEASUREMENTS - Structured Data Capture
// ============================================

enum MeasurementType {
  NUMERIC
  PASS_FAIL
  TEXT
}

model MeasurementDefinition {
  id                  String          @id @default(uuid()) @db.Uuid
  orgId               String          @db.Uuid
  standardsPackTaskId String?         @db.Uuid // Link to template task (nullable)
  taskInstanceId      String?         @db.Uuid // Link to actual task instance (nullable)
  name                String // e.g., "Bearing Temperature"
  unit                String? // e.g., "°F", "mils", "psi"
  measurementType     MeasurementType @default(NUMERIC)
  minValue            Float? // Acceptable range min (for NUMERIC)
  maxValue            Float? // Acceptable range max (for NUMERIC)
  isRequired          Boolean         @default(false)
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  org               Org                @relation(fields: [orgId], references: [id])
  standardsPackTask StandardsPackTask? @relation(fields: [standardsPackTaskId], references: [id], onDelete: Cascade)
  taskInstance      TaskInstance?      @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  taskMeasurements  TaskMeasurement[]

  @@index([orgId])
  @@index([orgId, standardsPackTaskId])
  @@index([orgId, taskInstanceId])
}

model TaskMeasurement {
  id                      String          @id @default(uuid()) @db.Uuid
  orgId                   String          @db.Uuid
  taskInstanceId          String          @db.Uuid
  measurementDefinitionId String?         @db.Uuid // Link to original definition (nullable for ad-hoc)
  name                    String // Copied from definition or custom
  unit                    String?
  measurementType         MeasurementType @default(NUMERIC)
  minValue                Float?
  maxValue                Float?
  // Captured values
  numericValue            Float?
  textValue               String?
  passFail                Boolean?
  // Calculated
  isWithinSpec            Boolean? // Auto-calculated for NUMERIC type
  // Metadata
  capturedAt              DateTime?
  capturedByUserId        String?         @db.Uuid
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  org                   Org                    @relation(fields: [orgId], references: [id])
  taskInstance          TaskInstance           @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  measurementDefinition MeasurementDefinition? @relation(fields: [measurementDefinitionId], references: [id])
  capturedByUser        User?                  @relation("MeasurementCapturedBy", fields: [capturedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, taskInstanceId])
  @@index([taskInstanceId])
}

// ============================================
// MATERIALS - Parts/Inventory Tracking
// ============================================

enum MaterialCategory {
  PART
  CONSUMABLE
  FLUID
  OTHER
}

model Material {
  id           String           @id @default(uuid()) @db.Uuid
  orgId        String           @db.Uuid
  name         String
  partNumber   String?
  manufacturer String?
  unitCost     Float?
  unit         String? // "each", "ft", "gal", etc.
  category     MaterialCategory @default(PART)
  isActive     Boolean          @default(true)

  // Inventory Management
  quantityOnHand Decimal   @default(0) @db.Decimal(10, 2)
  minQuantity    Decimal?  @db.Decimal(10, 2) // Reorder point
  maxQuantity    Decimal?  @db.Decimal(10, 2) // Max stock level
  location       String? // Storage location
  lastRestocked  DateTime? // Last time stock was added

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org            Org                 @relation(fields: [orgId], references: [id])
  usages         TaskMaterialUsage[]
  quoteLineItems QuoteLineItem[]
  stockMovements StockMovement[]

  @@index([orgId])
  @@index([orgId, isActive])
  @@index([orgId, category])
  @@index([orgId, quantityOnHand]) // For low stock queries
}

enum StockMovementType {
  PURCHASE // Incoming stock from supplier
  ADJUSTMENT // Manual adjustment (count correction)
  USAGE // Used in work order
  RETURN // Returned to stock
  TRANSFER // Transfer between locations
  WRITE_OFF // Damaged/lost inventory
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  orgId             String            @db.Uuid
  materialId        String            @db.Uuid
  movementType      StockMovementType
  quantity          Decimal           @db.Decimal(10, 2)
  quantityBefore    Decimal           @db.Decimal(10, 2) // Stock before transaction
  quantityAfter     Decimal           @db.Decimal(10, 2) // Stock after transaction
  unitCost          Decimal?          @db.Decimal(12, 2) // Cost per unit (for purchases)
  totalCost         Decimal?          @db.Decimal(12, 2) // Total transaction cost
  reference         String? // PO #, WO #, adjustment reason
  notes             String?
  performedByUserId String            @db.Uuid
  createdAt         DateTime          @default(now())

  org         Org      @relation(fields: [orgId], references: [id])
  material    Material @relation(fields: [materialId], references: [id])
  performedBy User     @relation("StockMovementPerformedBy", fields: [performedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, materialId])
  @@index([orgId, movementType])
  @@index([orgId, createdAt])
}

model TaskMaterialUsage {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  taskInstanceId String   @db.Uuid
  materialId     String?  @db.Uuid // Optional link to catalog
  name           String
  partNumber     String?
  quantity       Float    @default(1)
  unitCost       Float?
  unit           String?
  totalCost      Float?
  notes          String?
  addedByUserId  String?  @db.Uuid
  addedAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org              Org               @relation(fields: [orgId], references: [id])
  taskInstance     TaskInstance      @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  material         Material?         @relation(fields: [materialId], references: [id])
  addedByUser      User?             @relation("MaterialUsageAddedBy", fields: [addedByUserId], references: [id])
  invoiceLineItems InvoiceLineItem[]

  @@index([orgId])
  @@index([orgId, taskInstanceId])
  @@index([taskInstanceId])
}

// ============================================
// SIGNATURES - Customer/Tech Sign-off
// ============================================

enum SignatureType {
  CUSTOMER
  TECH
  WITNESS
}

model Signature {
  id               String        @id @default(uuid()) @db.Uuid
  orgId            String        @db.Uuid
  workOrderId      String        @db.Uuid
  signatureType    SignatureType
  signerName       String
  signerTitle      String? // e.g., "Plant Manager", "Lead Tech"
  signatureData    String        @db.Text // Base64 PNG or SVG path data
  signedAt         DateTime      @default(now())
  capturedByUserId String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  org        Org       @relation(fields: [orgId], references: [id])
  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  capturedBy User?     @relation("SignatureCapturedBy", fields: [capturedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([workOrderId])
}

// ============================================
// QUOTES MODULE
// ============================================

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELED
}

enum QuoteLineItemType {
  LABOR
  MATERIAL
  SERVICE
  OTHER
}

model Quote {
  id                    String      @id @default(uuid()) @db.Uuid
  orgId                 String      @db.Uuid
  customerId            String      @db.Uuid
  siteId                String?     @db.Uuid
  quoteNumber           String
  status                QuoteStatus @default(DRAFT)
  title                 String
  description           String?
  laborRate             Decimal?    @db.Decimal(10, 2) // Per-hour rate
  materialMarkupPercent Decimal?    @db.Decimal(5, 2) // e.g., 15.00 = 15%
  subtotal              Decimal     @default(0) @db.Decimal(12, 2)
  tax                   Decimal     @default(0) @db.Decimal(12, 2)
  taxRate               Decimal     @default(0) @db.Decimal(5, 2) // e.g., 8.25 = 8.25%
  total                 Decimal     @default(0) @db.Decimal(12, 2)
  validUntil            DateTime?
  notes                 String?     @db.Text
  terms                 String?     @db.Text
  sentAt                DateTime?
  approvedAt            DateTime?
  approvedByName        String?
  rejectedAt            DateTime?
  rejectionReason       String?
  convertedToOrderId    String?     @db.Uuid // Reference to created WO/SO/PJ
  convertedToOrderType  OrderType?
  createdByUserId       String      @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  org        Org             @relation(fields: [orgId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  site       Site?           @relation(fields: [siteId], references: [id])
  createdBy  User            @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  lineItems  QuoteLineItem[]
  invoices   Invoice[]
  workOrders WorkOrder[] // Work orders created from this quote

  // CRM relations
  opportunityConversion Opportunity? @relation("OpportunityQuote")

  @@unique([orgId, quoteNumber])
  @@index([orgId])
  @@index([orgId, customerId])
  @@index([orgId, status])
}

model QuoteLineItem {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @db.Uuid
  quoteId     String            @db.Uuid
  itemType    QuoteLineItemType
  description String
  quantity    Decimal           @db.Decimal(10, 2)
  unitPrice   Decimal           @db.Decimal(12, 2)
  totalPrice  Decimal           @db.Decimal(12, 2) // quantity * unitPrice
  materialId  String?           @db.Uuid // Optional link to Material catalog
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  org      Org       @relation(fields: [orgId], references: [id])
  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@index([orgId])
  @@index([quoteId])
}

// ============================================
// INVOICING MODULE
// ============================================

// Billing Configuration for Organizations
model BillingConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  orgId                 String   @unique @db.Uuid
  defaultTaxRate        Decimal  @default(0) @db.Decimal(5, 2) // e.g., 8.25 = 8.25%
  materialMarkupPercent Decimal  @default(0) @db.Decimal(5, 2) // e.g., 15.00 = 15%
  defaultPaymentTerms   String   @default("Payment due within 30 days")
  invoicePrefix         String   @default("INV")
  quotePrefix           String   @default("QTE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Labor Rate Configuration per Role
model LaborRateConfig {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  role       Role // TECH, ADMIN, DISPATCHER
  hourlyRate Decimal  @db.Decimal(10, 2) // e.g., 85.00
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, role])
  @@index([orgId])
}

// Named Labor Rates (Settings)
model LaborRate {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String?
  hourlyRate  Decimal  @db.Decimal(10, 2)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ============================================
// INVOICES - Post-Work Billing
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
}

enum InvoiceLineItemType {
  LABOR
  MATERIAL
  SERVICE
  OTHER
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @db.Uuid
  customerId      String        @db.Uuid
  siteId          String?       @db.Uuid
  workOrderId     String?       @db.Uuid // Optional - invoice can exist without WO
  quoteId         String?       @db.Uuid // Optional reference
  invoiceNumber   String
  status          InvoiceStatus @default(DRAFT)
  title           String
  description     String?
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2) // e.g., 8.25 = 8.25%
  total           Decimal       @default(0) @db.Decimal(12, 2)
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?       @db.Text
  terms           String?       @db.Text
  qboInvoiceId    String? // QuickBooks invoice ID
  qboSyncedAt     DateTime? // Last synced to QBO
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org       Org               @relation(fields: [orgId], references: [id])
  customer  Customer          @relation(fields: [customerId], references: [id])
  site      Site?             @relation(fields: [siteId], references: [id])
  workOrder WorkOrder?        @relation(fields: [workOrderId], references: [id])
  quote     Quote?            @relation(fields: [quoteId], references: [id])
  createdBy User              @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  lineItems InvoiceLineItem[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([orgId, customerId])
  @@index([orgId, status])
  @@index([workOrderId])
}

model InvoiceLineItem {
  id              String              @id @default(uuid()) @db.Uuid
  orgId           String              @db.Uuid
  invoiceId       String              @db.Uuid
  itemType        InvoiceLineItemType
  description     String
  quantity        Decimal             @db.Decimal(10, 2)
  unitPrice       Decimal             @db.Decimal(12, 2)
  totalPrice      Decimal             @db.Decimal(12, 2) // quantity * unitPrice
  taskId          String?             @db.Uuid // Optional link to task
  materialUsageId String?             @db.Uuid // Optional link to material usage
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  org           Org                @relation(fields: [orgId], references: [id])
  invoice       Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  task          TaskInstance?      @relation(fields: [taskId], references: [id])
  materialUsage TaskMaterialUsage? @relation(fields: [materialUsageId], references: [id])

  @@index([orgId])
  @@index([invoiceId])
}

// ============================================
// AI ORCHESTRATOR - Procedure Templates & Task Generation
// ============================================

enum ProcedureTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AITaskPlanStatus {
  GENERATING
  GENERATED
  APPROVED
  REJECTED
  ERROR
}

model ProcedureTemplate {
  id                String                  @id @default(uuid()) @db.Uuid
  orgId             String                  @db.Uuid
  name              String
  description       String?                 @db.Text
  assetCategory     AssetCategory?
  assetFamily       AssetFamily?
  assetSubFamily    AssetSubFamily?
  context           String? // REPAIR, STARTUP, PM, INSTALL, INSPECTION, TROUBLE
  standardsPackId   String?                 @db.Uuid
  version           Int                     @default(1)
  status            ProcedureTemplateStatus @default(DRAFT)
  aiSummary         String?                 @db.Text
  estimatedDuration Int? // Minutes
  createdByUserId   String                  @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  org           Org                     @relation(fields: [orgId], references: [id])
  standardsPack StandardsPack?          @relation(fields: [standardsPackId], references: [id])
  createdBy     User                    @relation("ProcedureTemplateCreatedBy", fields: [createdByUserId], references: [id])
  steps         ProcedureStepTemplate[]
  aiTaskPlans   AITaskPlan[]
  pmSchedules   WorkflowDefinition[]    @relation("PMScheduleProcedure")

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, assetCategory])
  @@index([orgId, assetFamily])
}

model ProcedureStepTemplate {
  id                       String   @id @default(uuid()) @db.Uuid
  orgId                    String   @db.Uuid
  procedureTemplateId      String   @db.Uuid
  sequenceNumber           Int
  title                    String
  description              String?  @db.Text
  domain                   String? // MECHANICAL, ELECTRICAL, CONTROLS, INSTRUMENTATION
  isCritical               Boolean  @default(false)
  requiresEvidence         Boolean  @default(false)
  appliesWhenJson          Json? // Conditions for when this step applies
  measurementSchemaJson    Json? // Expected measurements
  evidenceRequirementsJson Json? // Photo/file requirements
  estimatedMinutes         Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  org               Org               @relation(fields: [orgId], references: [id])
  procedureTemplate ProcedureTemplate @relation(fields: [procedureTemplateId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, procedureTemplateId])
  @@index([procedureTemplateId, sequenceNumber])
}

model WorkflowDefinition {
  id                       String                   @id @default(uuid()) @db.Uuid
  orgId                    String                   @db.Uuid
  name                     String
  description              String?                  @db.Text
  workOrderContext         String? // REPAIR, STARTUP, PM, etc.
  version                  Int                      @default(1)
  status                   WorkflowDefinitionStatus @default(DRAFT)
  baseStructureJson        Json? // Base workflow structure
  aiPromptTemplate         String?                  @db.Text
  // PM Scheduling fields
  assetId                  String?                  @db.Uuid
  siteId                   String?                  @db.Uuid
  customerId               String?                  @db.Uuid
  procedureTemplateId      String?                  @db.Uuid
  frequencyType            String? // DAILY, WEEKLY, MONTHLY, YEARLY
  frequencyValue           Int? // How many units between PMs
  nextScheduledDate        DateTime?
  lastGeneratedDate        DateTime?
  lastGeneratedWorkOrderId String?                  @db.Uuid
  autoGenerateWorkOrders   Boolean                  @default(false)
  workOrderTitle           String?
  estimatedHours           Float?
  priority                 String? // LOW, MEDIUM, HIGH, CRITICAL
  executionCount           Int                      @default(0)
  createdByUserId          String                   @db.Uuid
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  org                    Org                @relation(fields: [orgId], references: [id])
  createdBy              User               @relation("WorkflowDefinitionCreatedBy", fields: [createdByUserId], references: [id])
  asset                  Asset?             @relation("PMScheduleAsset", fields: [assetId], references: [id])
  site                   Site?              @relation("PMScheduleSite", fields: [siteId], references: [id])
  customer               Customer?          @relation("PMScheduleCustomer", fields: [customerId], references: [id])
  procedureTemplate      ProcedureTemplate? @relation("PMScheduleProcedure", fields: [procedureTemplateId], references: [id])
  lastGeneratedWorkOrder WorkOrder?         @relation("PMLastGeneratedWO", fields: [lastGeneratedWorkOrderId], references: [id])
  generatedWorkOrders    WorkOrder[]        @relation("PMGeneratedWOs")
  aiTaskPlans            AITaskPlan[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, assetId])
  @@index([orgId, nextScheduledDate])
}

model AITaskPlan {
  id                      String           @id @default(uuid()) @db.Uuid
  orgId                   String           @db.Uuid
  workOrderId             String           @db.Uuid
  procedureTemplateId     String?          @db.Uuid
  workflowDefinitionId    String?          @db.Uuid
  status                  AITaskPlanStatus @default(GENERATING)
  llmModel                String // e.g., "claude-sonnet-4-20250514"
  llmProvider             String           @default("anthropic")
  promptPayloadJson       Json // Full prompt sent to LLM
  llmRawResponseJson      Json? // Raw LLM response
  parsedTasksSnapshotJson Json? // Structured task data
  generatedAt             DateTime         @default(now())
  approvedAt              DateTime?
  approvedByUserId        String?          @db.Uuid
  rejectedAt              DateTime?
  rejectionReason         String?          @db.Text
  errorMessage            String?          @db.Text
  tokensUsed              Int?
  durationMs              Int?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  org                Org                 @relation(fields: [orgId], references: [id])
  workOrder          WorkOrder           @relation(fields: [workOrderId], references: [id])
  procedureTemplate  ProcedureTemplate?  @relation(fields: [procedureTemplateId], references: [id])
  workflowDefinition WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id])
  approvedBy         User?               @relation("AITaskPlanApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([workOrderId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  orgId     String    @db.Uuid
  type      String
  title     String
  message   String
  actionUrl String?
  metadata  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("NotificationUser", fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@index([userId, readAt])
  @@index([orgId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  orgId      String   @db.Uuid
  action     String
  entityType String
  entityId   String
  entityName String?
  changes    String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation("AuditLogUser", fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// ============================================
// WORK ORDER PHOTOS - Field Photo Capture
// ============================================

model WorkOrderPhoto {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @db.Uuid
  workOrderId       String    @db.Uuid
  photoType         PhotoType @default(GENERAL)
  fileId            String    @db.Uuid
  storageKey        String
  caption           String?
  latitude          Float?
  longitude         Float?
  isCustomerVisible Boolean   @default(false)
  uploadedByUserId  String    @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org        Org       @relation(fields: [orgId], references: [id])
  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("PhotoUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([workOrderId, photoType])
}

// ============================================
// TASK FINDINGS - Field Tech Observations
// ============================================

model TaskFinding {
  id              String          @id @default(uuid()) @db.Uuid
  orgId           String          @db.Uuid
  taskInstanceId  String          @db.Uuid
  category        String // SAFETY, DEFICIENCY, RECOMMENDATION, OBSERVATION
  details         String          @db.Text
  priority        FindingPriority @default(MEDIUM)
  photoUrl        String?
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  org           Org          @relation(fields: [orgId], references: [id])
  taskInstance  TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("TaskFindingCreatedBy", fields: [createdByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, taskInstanceId])
}

// ============================================
// SITE CHECK-IN/CHECK-OUT - GPS Tracking
// ============================================

model SiteCheckIn {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  workOrderId String    @db.Uuid
  userId      String    @db.Uuid
  checkInAt   DateTime  @default(now())
  checkOutAt  DateTime?
  latitude    Float?
  longitude   Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org       Org       @relation(fields: [orgId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  user      User      @relation("SiteCheckInUser", fields: [userId], references: [id])

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([userId])
}

// ============================================
// TECH PHOTO LIBRARY - Free Camera Photos
// ============================================

model TechPhoto {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  userId       String    @db.Uuid
  photoType    PhotoType
  caption      String?   @db.Text
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  gpsLatitude  Float?
  gpsLongitude Float?
  workOrderId  String?   @db.Uuid // Can be attached to WO later
  attachedAt   DateTime? // When attached to WO
  capturedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org       Org        @relation(fields: [orgId], references: [id])
  user      User       @relation("TechPhotoUser", fields: [userId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([orgId])
  @@index([orgId, userId])
  @@index([userId, capturedAt])
  @@index([workOrderId])
}

// ============================================
// QUICKBOOKS ONLINE INTEGRATION
// ============================================

model QboConnection {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @unique @db.Uuid // One QBO connection per org
  realmId           String // QBO Company ID
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  accessTokenExpiry DateTime
  companyName       String?
  isActive          Boolean   @default(true)
  connectedAt       DateTime  @default(now())
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org      Org          @relation(fields: [orgId], references: [id])
  syncLogs QboSyncLog[]

  @@index([orgId])
}

model QboSyncLog {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  connectionId String   @db.Uuid
  entityType   String // "customer", "invoice", "payment"
  entityId     String   @db.Uuid // ServiceOps entity ID
  qboEntityId  String? // QBO entity ID
  action       String // "push", "pull", "error"
  status       String // "success", "failed", "pending"
  errorMessage String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  connection QboConnection @relation(fields: [connectionId], references: [id])

  @@index([orgId, entityType])
  @@index([connectionId])
}

// ============================================
// CUSTOMER PORTAL
// ============================================

model CustomerPortalToken {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  customerId String    @db.Uuid
  token      String    @unique @default(uuid())
  email      String
  isActive   Boolean   @default(true)
  expiresAt  DateTime? // null = never expires
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  org      Org      @relation(fields: [orgId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([token])
  @@index([orgId, customerId])
}

// ============================================
// CUSTOM FORM RESPONSES
// ============================================

model FormResponse {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id])

  reportTemplateId String         @db.Uuid
  reportTemplate   ReportTemplate @relation(fields: [reportTemplateId], references: [id])
  templateSnapshot Json?

  workOrderId String?    @db.Uuid
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  siteId      String?    @db.Uuid
  site        Site?      @relation(fields: [siteId], references: [id])
  assetId     String?    @db.Uuid
  asset       Asset?     @relation(fields: [assetId], references: [id])

  data   Json               @default("{}")
  status FormResponseStatus @default(DRAFT)

  filledByUserId String    @db.Uuid
  filledBy       User      @relation("FilledFormResponses", fields: [filledByUserId], references: [id])
  submittedAt    DateTime?
  submissionLat  Float?
  submissionLng  Float?
  pdfUrl         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([workOrderId])
  @@index([reportTemplateId])
  @@index([filledByUserId])
}

// ═══════════════════════════════════════════════
// CRM Config Tables
// ═══════════════════════════════════════════════

model LeadSource {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org       Org        @relation(fields: [orgId], references: [id])
  customers Customer[]

  @@index([orgId])
}

model CallType {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org      Org       @relation(fields: [orgId], references: [id])
  callLogs CallLog[]

  @@index([orgId])
}

model CallOutcome {
  id                        String   @id @default(uuid()) @db.Uuid
  orgId                     String   @db.Uuid
  name                      String
  triggersFollowUp          Boolean  @default(false)
  triggersOpportunityPrompt Boolean  @default(false)
  displayOrder              Int      @default(0)
  isActive                  Boolean  @default(true)
  isDefault                 Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  org      Org       @relation(fields: [orgId], references: [id])
  callLogs CallLog[]

  @@index([orgId])
}

model FollowUpType {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ═══════════════════════════════════════════════
// CRM Core Tables
// ═══════════════════════════════════════════════

model Contact {
  id                     String         @id @default(uuid()) @db.Uuid
  orgId                  String         @db.Uuid
  customerId             String         @db.Uuid
  firstName              String
  lastName               String
  title                  String?
  email                  String?
  phone                  String?
  mobilePhone            String?
  preferredContactMethod ContactMethod?
  isDecisionMaker        Boolean        @default(false)
  isTechnicalInfluencer  Boolean        @default(false)
  isGatekeeper           Boolean        @default(false)
  isPrimary              Boolean        @default(false)
  notes                  String?
  status                 ContactStatus  @default(ACTIVE)
  createdByUserId        String?        @db.Uuid
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  org            Org            @relation(fields: [orgId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  createdBy      User?          @relation("ContactCreatedBy", fields: [createdByUserId], references: [id])
  callLogs       CallLog[]
  followUps      FollowUp[]
  opportunities  Opportunity[]
  serviceTickets ServiceTicket[]

  @@index([orgId])
  @@index([customerId])
  @@index([orgId, customerId])
}

model CallLog {
  id                String     @id @default(uuid()) @db.Uuid
  orgId             String     @db.Uuid
  userId            String     @db.Uuid
  customerId        String     @db.Uuid
  siteId            String?    @db.Uuid
  contactId         String?    @db.Uuid
  callTypeId        String     @db.Uuid
  callOutcomeId     String     @db.Uuid
  callMethod        CallMethod
  callDuration      Int?
  competitorMentioned String?
  notes             String?
  callTimestamp     DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  org         Org         @relation(fields: [orgId], references: [id])
  user        User        @relation("CallLogUser", fields: [userId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  site        Site?       @relation(fields: [siteId], references: [id])
  contact     Contact?    @relation(fields: [contactId], references: [id])
  callType    CallType    @relation(fields: [callTypeId], references: [id])
  callOutcome CallOutcome @relation(fields: [callOutcomeId], references: [id])
  followUps   FollowUp[]
  opportunities Opportunity[]

  @@index([orgId])
  @@index([orgId, userId])
  @@index([orgId, customerId])
}

model FollowUp {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @db.Uuid
  callLogId        String?          @db.Uuid
  customerId       String           @db.Uuid
  siteId           String?          @db.Uuid
  contactId        String?          @db.Uuid
  assignedToUserId String           @db.Uuid
  createdByUserId  String           @db.Uuid
  title            String
  description      String?
  dueDate          DateTime
  priority         FollowUpPriority @default(NORMAL)
  status           FollowUpStatus   @default(PENDING)
  completedAt      DateTime?
  reminderSent     Boolean          @default(false)
  outlookEventId   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  org        Org      @relation(fields: [orgId], references: [id])
  callLog    CallLog? @relation(fields: [callLogId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  site       Site?    @relation(fields: [siteId], references: [id])
  contact    Contact? @relation(fields: [contactId], references: [id])
  assignedTo User     @relation("FollowUpAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy  User     @relation("FollowUpCreatedBy", fields: [createdByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, assignedToUserId])
  @@index([orgId, dueDate])
  @@index([orgId, status])
}

model Opportunity {
  id                String            @id @default(uuid()) @db.Uuid
  orgId             String            @db.Uuid
  callLogId         String?           @db.Uuid
  customerId        String            @db.Uuid
  siteId            String?           @db.Uuid
  contactId         String?           @db.Uuid
  createdByUserId   String            @db.Uuid
  name              String
  description       String?
  amount            Decimal?          @db.Decimal(12, 2)
  status            OpportunityStatus @default(PROSPECTING)
  expectedCloseDate DateTime?
  wonLostAt         DateTime?
  wonLostReason     String?
  convertedQuoteId  String?           @unique @db.Uuid
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  org            Org       @relation(fields: [orgId], references: [id])
  callLog        CallLog?  @relation(fields: [callLogId], references: [id])
  customer       Customer  @relation(fields: [customerId], references: [id])
  site           Site?     @relation(fields: [siteId], references: [id])
  contact        Contact?  @relation(fields: [contactId], references: [id])
  createdBy      User      @relation("OpportunityCreatedBy", fields: [createdByUserId], references: [id])
  convertedQuote Quote?    @relation("OpportunityQuote", fields: [convertedQuoteId], references: [id])

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, createdByUserId])
}

model ServiceTicket {
  id                    String        @id @default(uuid()) @db.Uuid
  orgId                 String        @db.Uuid
  createdByUserId       String        @db.Uuid
  customerId            String        @db.Uuid
  siteId                String?       @db.Uuid
  contactId             String?       @db.Uuid
  contactName           String?
  contactPhone          String?
  reasonForService      String
  serviceRequestedDate  DateTime?
  urgency               TicketUrgency @default(NORMAL)
  notes                 String?
  siteAddress           String?
  convertedWorkOrderId  String?       @unique @db.Uuid
  status                TicketStatus  @default(OPEN)
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  org                Org        @relation(fields: [orgId], references: [id])
  createdBy          User       @relation("ServiceTicketCreatedBy", fields: [createdByUserId], references: [id])
  customer           Customer   @relation(fields: [customerId], references: [id])
  site               Site?      @relation(fields: [siteId], references: [id])
  contact            Contact?   @relation(fields: [contactId], references: [id])
  convertedWorkOrder WorkOrder? @relation("TicketWorkOrder", fields: [convertedWorkOrderId], references: [id])

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, createdByUserId])
}
