generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  TECH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ExecutionMode {
  UNIFIED
  MULTI_LANE
}

enum OrderType {
  WORK_ORDER
  SALES_ORDER
  PROJECT
}

enum WorkPackageType {
  MECH_ELEC_UNIFIED
  MECHANICAL
  ELECTRICAL
  CONTROLS
  INSTRUMENTATION
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
}

enum AssetCategory {
  ROTATING_EQUIPMENT
  CONTROLS_AND_ELECTRICAL
  INSTRUMENTATION
  OTHER
}

enum AssetFamily {
  // Rotating Equipment Families
  PUMP
  MOTOR
  GEARBOX
  // Controls & Electrical Families
  CONTROL_PANEL
  ELECTRICAL_FEED_SYSTEM
  // Instrumentation Family
  SENSOR
  // Other
  OTHER
}

enum AssetSubFamily {
  // Pump Sub-Families
  SUBMERSIBLE_WASTEWATER
  VERTICAL_TURBINE
  HORIZONTAL_SPLIT_CASE
  END_SUCTION
  ANSI_API_PROCESS_PUMP
  // Motor Sub-Families
  LOW_VOLTAGE_TEFC_ODP
  MEDIUM_VOLTAGE
  EXPLOSION_PROOF
  // Gearbox Sub-Families
  WORM
  HELICAL
  PLANETARY
  // Control Panel Sub-Families
  UL508A_INDUSTRIAL_PANEL
  PUMP_CONTROL_PANEL
  MCC_BUCKET
  STARTER_VFD
  STARTER_SOFT_STARTER
  STARTER_ACROSS_THE_LINE
  // Instrumentation Sub-Families
  LEVEL
  PRESSURE
  FLOW
  TEMPERATURE
  // Electrical Feed System Sub-Families
  TRANSFORMER
  BREAKER
  DISCONNECT
  FEEDER_SYSTEM
  // Other
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

enum TaskEvidenceType {
  NOTE
  PHOTO
  FILE
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ReportTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ReportBlockType {
  HEADING
  RICH_TEXT
  TABLE
  IMAGE
}

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  invites      Invite[]
  customers    Customer[]
  sites        Site[]
  assets       Asset[]
  workOrders   WorkOrder[]
  visits       Visit[]
  findings     Finding[]
  measures     Measurement[]
  files        File[]
  fileLinks   FileLink[]
  reports      Report[]
  kbFiles      KbFile[]
  kbChunks     KbChunk[]
  workPackages WorkPackage[]
  tasks        TaskInstance[]
  taskEvidence TaskEvidence[]
  reportTemplates ReportTemplate[]
  reportBlocks ReportBlock[]
  timeEntries  TimeEntry[]
  standardsPacks StandardsPack[]
  standardsPackTasks StandardsPackTask[]
  measurementDefinitions MeasurementDefinition[]
  taskMeasurements TaskMeasurement[]
  materials Material[]
  taskMaterialUsages TaskMaterialUsage[]
  signatures Signature[]
  quotes Quote[]
  quoteLineItems QuoteLineItem[]
  invoices Invoice[]
  invoiceLineItems InvoiceLineItem[]
  procedureTemplates ProcedureTemplate[]
  procedureStepTemplates ProcedureStepTemplate[]
  workflowDefinitions WorkflowDefinition[]
  aiTaskPlans AITaskPlan[]
  billingConfig BillingConfig?
  laborRates LaborRateConfig[]
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  email     String
  name      String?
  role      Role     @default(TECH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org            Org           @relation(fields: [orgId], references: [id])
  invitesSent    Invite[]      @relation("InviteSentBy")
  assignedVisits Visit[]       @relation("VisitAssignedTech")
  leadPackages   WorkPackage[]   @relation("WorkPackageLead")
  assignedTasks  TaskInstance[]  @relation("TaskAssignedTo")
  createdTaskEvidence TaskEvidence[] @relation("TaskEvidenceCreatedBy")
  createdReportTemplates ReportTemplate[] @relation("ReportTemplateCreatedBy")
  updatedReportTemplates ReportTemplate[] @relation("ReportTemplateUpdatedBy")
  timeEntries  TimeEntry[]  @relation("TimeEntryUser")
  capturedMeasurements TaskMeasurement[] @relation("MeasurementCapturedBy")
  addedMaterialUsages TaskMaterialUsage[] @relation("MaterialUsageAddedBy")
  capturedSignatures Signature[] @relation("SignatureCapturedBy")
  createdQuotes Quote[] @relation("QuoteCreatedBy")
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  createdProcedureTemplates ProcedureTemplate[] @relation("ProcedureTemplateCreatedBy")
  createdWorkflowDefinitions WorkflowDefinition[] @relation("WorkflowDefinitionCreatedBy")
  approvedAITaskPlans AITaskPlan[] @relation("AITaskPlanApprovedBy")

  @@unique([orgId, email])
  @@index([orgId])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Org   @relation(fields: [orgId], references: [id])
  invitedBy User? @relation("InviteSentBy", fields: [invitedById], references: [id])

  @@index([orgId])
  @@index([orgId, email])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  status    String   @default("ACTIVE")
  primaryEmail  String?
  primaryPhone  String?
  billingAddress String?
  billingStreet1    String?
  billingStreet2    String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String?
  notes         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Org        @relation(fields: [orgId], references: [id])
  sites     Site[]
  assets    Asset[]
  workOrders WorkOrder[]
  quotes    Quote[]
  invoices  Invoice[]

  @@index([orgId])
}

model Site {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  customerId String   @db.Uuid
  name       String
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  assets   Asset[]
  workOrders WorkOrder[]
  quotes   Quote[]
  invoices Invoice[]

  @@index([orgId])
  @@index([orgId, customerId])
}

model Asset {
  id                     String            @id @default(uuid()) @db.Uuid
  orgId                  String            @db.Uuid
  customerId             String            @db.Uuid
  siteId                 String            @db.Uuid
  name                   String
  manufacturer           String?
  model                  String?
  serialNumber           String?
  assetTag               String?
  assetCategory          AssetCategory?
  assetFamily            AssetFamily?
  assetSubFamily         AssetSubFamily?
  location               String?
  notes                  String?
  status                 AssetStatus       @default(ACTIVE)
  criticality            AssetCriticality?
  nameplateSchemaVersion Int               @default(1)
  nameplate              Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  org        Org        @relation(fields: [orgId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  site       Site       @relation(fields: [siteId], references: [id])
  workOrders WorkOrder[]

  @@index([orgId])
  @@index([orgId, siteId])
  @@index([orgId, customerId])
}

model WorkOrder {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  customerId  String          @db.Uuid
  siteId      String          @db.Uuid
  assetId     String?         @db.Uuid
  quoteId     String?         @db.Uuid // Optional - work order created from accepted quote
  title       String
  description String?
  status      WorkOrderStatus @default(OPEN)
  executionMode ExecutionMode @default(UNIFIED)
  orderType   OrderType       @default(WORK_ORDER)
  workOrderNumber String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  org      Org      @relation(fields: [orgId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  site     Site     @relation(fields: [siteId], references: [id])
  asset    Asset?   @relation(fields: [assetId], references: [id])
  quote    Quote?   @relation(fields: [quoteId], references: [id])
  visits   Visit[]
  packages WorkPackage[]
  tasks    TaskInstance[]
  timeEntries TimeEntry[]
  signatures Signature[]
  invoices Invoice[]
  aiTaskPlans AITaskPlan[]

  @@index([orgId])
  @@index([orgId, customerId])
  @@unique([orgId, workOrderNumber])
}

model WorkPackage {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  workOrderId String          @db.Uuid
  packageType WorkPackageType
  name        String
  status      String          @default("PLANNED")
  leadTechId  String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  org       Org       @relation(fields: [orgId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  leadTech  User?     @relation("WorkPackageLead", fields: [leadTechId], references: [id])
  tasks     TaskInstance[]

  @@index([orgId])
  @@index([orgId, workOrderId])
}

model TaskInstance {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @db.Uuid
  workOrderId   String      @db.Uuid
  workPackageId String      @db.Uuid
  title         String
  description   String?
  status        TaskStatus  @default(TODO)
  sequenceNumber Int?
  assignedToId  String?     @db.Uuid
  isCritical    Boolean     @default(false)
  requiresEvidence Boolean  @default(false)
  blockedById   String?     @db.Uuid  // Task that must complete before this one
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  org        Org         @relation(fields: [orgId], references: [id])
  workOrder  WorkOrder   @relation(fields: [workOrderId], references: [id])
  workPackage WorkPackage @relation(fields: [workPackageId], references: [id])
  assignedTo User?       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  blockedBy  TaskInstance? @relation("TaskDependency", fields: [blockedById], references: [id], onDelete: SetNull)
  blockingTasks TaskInstance[] @relation("TaskDependency")
  evidence   TaskEvidence[]
  timeEntries TimeEntry[]
  measurements TaskMeasurement[]
  materialUsages TaskMaterialUsage[]
  invoiceLineItems InvoiceLineItem[]
  measurementDefinitions MeasurementDefinition[]

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([orgId, workPackageId])
  @@index([blockedById])
}

model TaskEvidence {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @db.Uuid
  taskInstanceId  String           @db.Uuid
  type            TaskEvidenceType
  noteText        String?
  url             String?
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())

  org           Org         @relation(fields: [orgId], references: [id])
  taskInstance  TaskInstance @relation(fields: [taskInstanceId], references: [id])
  createdByUser User        @relation("TaskEvidenceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, taskInstanceId])
  @@index([orgId, createdByUserId])
}

model Visit {
  id             String     @id @default(uuid()) @db.Uuid
  orgId          String     @db.Uuid
  workOrderId    String     @db.Uuid
  assignedTechId String?    @db.Uuid
  status         VisitStatus @default(PLANNED)
  visitNumber    String?
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  summary        String?
  outcome        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org        Org      @relation(fields: [orgId], references: [id])
  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id])
  assignedTech User?   @relation("VisitAssignedTech", fields: [assignedTechId], references: [id])
  findings   Finding[]
  measures   Measurement[]
  files      File[]
  reports    Report[]

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@unique([orgId, visitNumber])
}

model Finding {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  visitId   String   @db.Uuid
  category  String
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org   @relation(fields: [orgId], references: [id])
  visit Visit @relation(fields: [visitId], references: [id])

  @@index([orgId])
  @@index([orgId, visitId])
}

model Measurement {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  visitId   String   @db.Uuid
  name      String
  value     String
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org   @relation(fields: [orgId], references: [id])
  visit Visit @relation(fields: [visitId], references: [id])

  @@index([orgId])
  @@index([orgId, visitId])
}

model File {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  visitId    String?  @db.Uuid
  reportId   String?  @db.Uuid
  kbFileId   String?  @db.Uuid
  filename   String
  mimeType   String
  storageKey String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id])
  visit  Visit?  @relation(fields: [visitId], references: [id])
  report Report? @relation(fields: [reportId], references: [id])
  kbFile KbFile? @relation(fields: [kbFileId], references: [id])

  links      FileLink[]

  @@index([orgId])
  @@index([orgId, visitId])
}

model FileLink {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  fileId     String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  label      String?
  createdAt  DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id])
  file File @relation(fields: [fileId], references: [id])

  @@index([orgId])
  @@index([orgId, entityType, entityId])
  @@index([orgId, fileId])
  @@unique([orgId, fileId, entityType, entityId])
}



model Report {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  visitId   String   @db.Uuid
  title     String
  status    String   @default("DRAFT")
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org   @relation(fields: [orgId], references: [id])
  visit  Visit @relation(fields: [visitId], references: [id])
  files  File[]

  @@index([orgId])
  @@index([orgId, visitId])
}

model ReportTemplate {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @db.Uuid
  name            String
  description     String?
  status          ReportTemplateStatus @default(DRAFT)
  schemaVersion   Int                  @default(1)
  definition      Json
  createdByUserId String               @db.Uuid
  updatedByUserId String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  org           Org  @relation(fields: [orgId], references: [id])
  createdByUser User @relation("ReportTemplateCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User? @relation("ReportTemplateUpdatedBy", fields: [updatedByUserId], references: [id])
  blocks        ReportBlock[] @relation("ReportTemplateBlocks")

  @@index([orgId])
  @@index([orgId, status])
}

model ReportBlock {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  reportTemplateId String          @db.Uuid
  type             ReportBlockType
  title            String?
  props            Json
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org            Org            @relation(fields: [orgId], references: [id])
  reportTemplate ReportTemplate @relation("ReportTemplateBlocks", fields: [reportTemplateId], references: [id])

  @@index([orgId])
  @@index([orgId, reportTemplateId])
  @@index([orgId, reportTemplateId, sortOrder])
}

model KbFile {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  title        String
  sourceUrl    String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org     Org      @relation(fields: [orgId], references: [id])
  files   File[]
  chunks  KbChunk[]

  @@index([orgId])
}

model KbChunk {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  kbFileId   String   @db.Uuid
  content    String
  tokenCount Int?
  embedding  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org    Org    @relation(fields: [orgId], references: [id])
  kbFile KbFile @relation(fields: [kbFileId], references: [id])

  @@index([orgId])
  @@index([orgId, kbFileId])
}

enum TimeEntryStatus {
  RUNNING
  PAUSED
  STOPPED
}

model TimeEntry {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @db.Uuid
  userId         String          @db.Uuid
  workOrderId    String          @db.Uuid
  taskInstanceId String?         @db.Uuid
  status         TimeEntryStatus @default(RUNNING)
  startedAt      DateTime        @default(now())
  pausedAt       DateTime?
  stoppedAt      DateTime?
  // Accumulated seconds before current running segment
  accumulatedSeconds Int         @default(0)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  org          Org           @relation(fields: [orgId], references: [id])
  user         User          @relation("TimeEntryUser", fields: [userId], references: [id])
  workOrder    WorkOrder     @relation(fields: [workOrderId], references: [id])
  taskInstance TaskInstance? @relation(fields: [taskInstanceId], references: [id])

  @@index([orgId])
  @@index([orgId, userId])
  @@index([orgId, workOrderId])
  @@index([orgId, taskInstanceId])
  @@index([userId, status])
}

model user_org_roles {
  user_id String @db.Uuid
  org_id  String @db.Uuid
  role    String

  @@id([user_id, org_id])
  @@index([user_id])
}



// ============================================
// STANDARDS PACKS - Reusable Task Templates
// ============================================

enum StandardsPackStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model StandardsPack {
  id              String              @id @default(uuid()) @db.Uuid
  orgId           String              @db.Uuid
  name            String
  description     String?
  equipmentType   String?             // e.g., "Centrifugal Pump", "Control Valve"
  status          StandardsPackStatus @default(DRAFT)
  estimatedHours  Float?              // Total estimated hours for all tasks
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  org   Org                  @relation(fields: [orgId], references: [id])
  tasks StandardsPackTask[]
  procedureTemplates ProcedureTemplate[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, equipmentType])
}

model StandardsPackTask {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  standardsPackId  String          @db.Uuid
  title            String
  description      String?
  packageType      WorkPackageType @default(MECH_ELEC_UNIFIED)
  sequenceNumber   Int             @default(0)
  isCritical       Boolean         @default(false)
  requiresEvidence Boolean         @default(false)
  estimatedMinutes Int?            // Estimated time for this task
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org           Org           @relation(fields: [orgId], references: [id])
  standardsPack StandardsPack @relation(fields: [standardsPackId], references: [id], onDelete: Cascade)
  measurementDefinitions MeasurementDefinition[]

  @@index([orgId])
  @@index([orgId, standardsPackId])
  @@index([standardsPackId, sequenceNumber])
}


// ============================================
// MEASUREMENTS - Structured Data Capture
// ============================================

enum MeasurementType {
  NUMERIC
  PASS_FAIL
  TEXT
}

model MeasurementDefinition {
  id                  String          @id @default(uuid()) @db.Uuid
  orgId               String          @db.Uuid
  standardsPackTaskId String?         @db.Uuid  // Link to template task (nullable)
  taskInstanceId      String?         @db.Uuid  // Link to actual task instance (nullable)
  name                String          // e.g., "Bearing Temperature"
  unit                String?         // e.g., "°F", "mils", "psi"
  measurementType     MeasurementType @default(NUMERIC)
  minValue            Float?          // Acceptable range min (for NUMERIC)
  maxValue            Float?          // Acceptable range max (for NUMERIC)
  isRequired          Boolean         @default(false)
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  org               Org                @relation(fields: [orgId], references: [id])
  standardsPackTask StandardsPackTask? @relation(fields: [standardsPackTaskId], references: [id], onDelete: Cascade)
  taskInstance      TaskInstance?      @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  taskMeasurements  TaskMeasurement[]

  @@index([orgId])
  @@index([orgId, standardsPackTaskId])
  @@index([orgId, taskInstanceId])
}

model TaskMeasurement {
  id                      String    @id @default(uuid()) @db.Uuid
  orgId                   String    @db.Uuid
  taskInstanceId          String    @db.Uuid
  measurementDefinitionId String?   @db.Uuid  // Link to original definition (nullable for ad-hoc)
  name                    String    // Copied from definition or custom
  unit                    String?
  measurementType         MeasurementType @default(NUMERIC)
  minValue                Float?
  maxValue                Float?
  // Captured values
  numericValue            Float?
  textValue               String?
  passFail                Boolean?
  // Calculated
  isWithinSpec            Boolean?  // Auto-calculated for NUMERIC type
  // Metadata
  capturedAt              DateTime?
  capturedByUserId        String?   @db.Uuid
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  org                   Org                    @relation(fields: [orgId], references: [id])
  taskInstance          TaskInstance           @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  measurementDefinition MeasurementDefinition? @relation(fields: [measurementDefinitionId], references: [id])
  capturedByUser        User?                  @relation("MeasurementCapturedBy", fields: [capturedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, taskInstanceId])
  @@index([taskInstanceId])
}


// ============================================
// MATERIALS - Parts/Inventory Tracking
// ============================================

enum MaterialCategory {
  PART
  CONSUMABLE
  FLUID
  OTHER
}

model Material {
  id           String           @id @default(uuid()) @db.Uuid
  orgId        String           @db.Uuid
  name         String
  partNumber   String?
  manufacturer String?
  unitCost     Float?
  unit         String?          // "each", "ft", "gal", etc.
  category     MaterialCategory @default(PART)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  org    Org                 @relation(fields: [orgId], references: [id])
  usages TaskMaterialUsage[]
  quoteLineItems QuoteLineItem[]

  @@index([orgId])
  @@index([orgId, isActive])
  @@index([orgId, category])
}

model TaskMaterialUsage {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  taskInstanceId String   @db.Uuid
  materialId     String?  @db.Uuid  // Optional link to catalog
  name           String
  partNumber     String?
  quantity       Float    @default(1)
  unitCost       Float?
  unit           String?
  totalCost      Float?
  notes          String?
  addedByUserId  String?  @db.Uuid
  addedAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org          Org           @relation(fields: [orgId], references: [id])
  taskInstance TaskInstance  @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  material     Material?     @relation(fields: [materialId], references: [id])
  addedByUser  User?         @relation("MaterialUsageAddedBy", fields: [addedByUserId], references: [id])
  invoiceLineItems InvoiceLineItem[]

  @@index([orgId])
  @@index([orgId, taskInstanceId])
  @@index([taskInstanceId])
}


// ============================================
// SIGNATURES - Customer/Tech Sign-off
// ============================================

enum SignatureType {
  CUSTOMER
  TECH
  WITNESS
}

model Signature {
  id            String        @id @default(uuid()) @db.Uuid
  orgId         String        @db.Uuid
  workOrderId   String        @db.Uuid
  signatureType SignatureType
  signerName    String
  signerTitle   String?       // e.g., "Plant Manager", "Lead Tech"
  signatureData String        @db.Text  // Base64 PNG or SVG path data
  signedAt      DateTime      @default(now())
  capturedByUserId String?    @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org         Org        @relation(fields: [orgId], references: [id])
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  capturedBy  User?      @relation("SignatureCapturedBy", fields: [capturedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([workOrderId])
}


// ============================================
// QUOTES MODULE
// ============================================

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum QuoteLineItemType {
  LABOR
  MATERIAL
  SERVICE
  OTHER
}

model Quote {
  id                    String       @id @default(uuid()) @db.Uuid
  orgId                 String       @db.Uuid
  customerId            String       @db.Uuid
  siteId                String?      @db.Uuid
  quoteNumber           String
  status                QuoteStatus  @default(DRAFT)
  title                 String
  description           String?
  laborRate             Decimal?     @db.Decimal(10, 2) // Per-hour rate
  materialMarkupPercent Decimal?     @db.Decimal(5, 2)  // e.g., 15.00 = 15%
  subtotal              Decimal      @default(0) @db.Decimal(12, 2)
  tax                   Decimal      @default(0) @db.Decimal(12, 2)
  total                 Decimal      @default(0) @db.Decimal(12, 2)
  validUntil            DateTime?
  notes                 String?      @db.Text
  terms                 String?      @db.Text
  sentAt                DateTime?
  approvedAt            DateTime?
  approvedByName        String?
  rejectedAt            DateTime?
  rejectionReason       String?
  convertedToOrderId    String?      @db.Uuid // Reference to created WO/SO/PJ
  convertedToOrderType  OrderType?
  createdByUserId       String       @db.Uuid
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  org       Org        @relation(fields: [orgId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
  site      Site?      @relation(fields: [siteId], references: [id])
  createdBy User       @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  lineItems QuoteLineItem[]
  invoices  Invoice[]

  @@unique([orgId, quoteNumber])
  @@index([orgId])
  @@index([orgId, customerId])
  @@index([orgId, status])
}

model QuoteLineItem {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @db.Uuid
  quoteId     String            @db.Uuid
  itemType    QuoteLineItemType
  description String
  quantity    Decimal           @db.Decimal(10, 2)
  unitPrice   Decimal           @db.Decimal(12, 2)
  totalPrice  Decimal           @db.Decimal(12, 2) // quantity * unitPrice
  materialId  String?           @db.Uuid // Optional link to Material catalog
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  org      Org       @relation(fields: [orgId], references: [id])
  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@index([orgId])
  @@index([quoteId])
}


// ============================================
// INVOICING MODULE
// ============================================

// Billing Configuration for Organizations
model BillingConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  orgId                 String   @unique @db.Uuid
  defaultTaxRate        Decimal  @default(0) @db.Decimal(5, 2) // e.g., 8.25 = 8.25%
  materialMarkupPercent Decimal  @default(0) @db.Decimal(5, 2) // e.g., 15.00 = 15%
  defaultPaymentTerms   String   @default("Payment due within 30 days")
  invoicePrefix         String   @default("INV")
  quotePrefix           String   @default("QTE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Labor Rate Configuration per Role
model LaborRateConfig {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  role       Role     // TECH, ADMIN, DISPATCHER
  hourlyRate Decimal  @db.Decimal(10, 2) // e.g., 85.00
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, role])
  @@index([orgId])
}


// ============================================
// INVOICES - Post-Work Billing
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
}

enum InvoiceLineItemType {
  LABOR
  MATERIAL
  SERVICE
  OTHER
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @db.Uuid
  customerId      String        @db.Uuid
  siteId          String?       @db.Uuid
  workOrderId     String?       @db.Uuid // Optional - invoice can exist without WO
  quoteId         String?       @db.Uuid // Optional reference
  invoiceNumber   String
  status          InvoiceStatus @default(DRAFT)
  title           String
  description     String?
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2) // e.g., 8.25 = 8.25%
  total           Decimal       @default(0) @db.Decimal(12, 2)
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?       @db.Text
  terms           String?       @db.Text
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org        Org                 @relation(fields: [orgId], references: [id])
  customer   Customer            @relation(fields: [customerId], references: [id])
  site       Site?               @relation(fields: [siteId], references: [id])
  workOrder  WorkOrder?          @relation(fields: [workOrderId], references: [id])
  quote      Quote?              @relation(fields: [quoteId], references: [id])
  createdBy  User                @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  lineItems  InvoiceLineItem[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([orgId, customerId])
  @@index([orgId, status])
  @@index([workOrderId])
}

model InvoiceLineItem {
  id              String              @id @default(uuid()) @db.Uuid
  orgId           String              @db.Uuid
  invoiceId       String              @db.Uuid
  itemType        InvoiceLineItemType
  description     String
  quantity        Decimal             @db.Decimal(10, 2)
  unitPrice       Decimal             @db.Decimal(12, 2)
  totalPrice      Decimal             @db.Decimal(12, 2) // quantity * unitPrice
  taskId          String?             @db.Uuid // Optional link to task
  materialUsageId String?             @db.Uuid // Optional link to material usage
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  org            Org                @relation(fields: [orgId], references: [id])
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  task           TaskInstance?      @relation(fields: [taskId], references: [id])
  materialUsage  TaskMaterialUsage? @relation(fields: [materialUsageId], references: [id])

  @@index([orgId])
  @@index([invoiceId])
}


// ============================================
// AI ORCHESTRATOR - Procedure Templates & Task Generation
// ============================================

enum ProcedureTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AITaskPlanStatus {
  GENERATING
  GENERATED
  APPROVED
  REJECTED
  ERROR
}

model ProcedureTemplate {
  id                  String                    @id @default(uuid()) @db.Uuid
  orgId               String                    @db.Uuid
  name                String
  description         String?                   @db.Text
  assetCategory       AssetCategory?
  assetFamily         AssetFamily?
  assetSubFamily      AssetSubFamily?
  context             String?                   // REPAIR, STARTUP, PM, INSTALL, INSPECTION, TROUBLE
  standardsPackId     String?                   @db.Uuid
  version             Int                       @default(1)
  status              ProcedureTemplateStatus   @default(DRAFT)
  aiSummary           String?                   @db.Text
  estimatedDuration   Int?                      // Minutes
  createdByUserId     String                    @db.Uuid
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  org           Org                     @relation(fields: [orgId], references: [id])
  standardsPack StandardsPack?          @relation(fields: [standardsPackId], references: [id])
  createdBy     User                    @relation("ProcedureTemplateCreatedBy", fields: [createdByUserId], references: [id])
  steps         ProcedureStepTemplate[]
  aiTaskPlans   AITaskPlan[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, assetCategory])
  @@index([orgId, assetFamily])
}

model ProcedureStepTemplate {
  id                       String            @id @default(uuid()) @db.Uuid
  orgId                    String            @db.Uuid
  procedureTemplateId      String            @db.Uuid
  sequenceNumber           Int
  title                    String
  description              String?           @db.Text
  domain                   String?           // MECHANICAL, ELECTRICAL, CONTROLS, INSTRUMENTATION
  isCritical               Boolean           @default(false)
  requiresEvidence         Boolean           @default(false)
  appliesWhenJson          Json?             // Conditions for when this step applies
  measurementSchemaJson    Json?             // Expected measurements
  evidenceRequirementsJson Json?             // Photo/file requirements
  estimatedMinutes         Int?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  org               Org               @relation(fields: [orgId], references: [id])
  procedureTemplate ProcedureTemplate @relation(fields: [procedureTemplateId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, procedureTemplateId])
  @@index([procedureTemplateId, sequenceNumber])
}

model WorkflowDefinition {
  id                  String                    @id @default(uuid()) @db.Uuid
  orgId               String                    @db.Uuid
  name                String
  description         String?                   @db.Text
  workOrderContext    String?                   // REPAIR, STARTUP, PM, etc.
  version             Int                       @default(1)
  status              WorkflowDefinitionStatus  @default(DRAFT)
  baseStructureJson   Json?                     // Base workflow structure
  aiPromptTemplate    String?                   @db.Text
  createdByUserId     String                    @db.Uuid
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  org         Org          @relation(fields: [orgId], references: [id])
  createdBy   User         @relation("WorkflowDefinitionCreatedBy", fields: [createdByUserId], references: [id])
  aiTaskPlans AITaskPlan[]

  @@index([orgId])
  @@index([orgId, status])
}

model AITaskPlan {
  id                      String            @id @default(uuid()) @db.Uuid
  orgId                   String            @db.Uuid
  workOrderId             String            @db.Uuid
  procedureTemplateId     String?           @db.Uuid
  workflowDefinitionId    String?           @db.Uuid
  status                  AITaskPlanStatus  @default(GENERATING)
  llmModel                String            // e.g., "claude-sonnet-4-20250514"
  llmProvider             String            @default("anthropic")
  promptPayloadJson       Json              // Full prompt sent to LLM
  llmRawResponseJson      Json?             // Raw LLM response
  parsedTasksSnapshotJson Json?             // Structured task data
  generatedAt             DateTime          @default(now())
  approvedAt              DateTime?
  approvedByUserId        String?           @db.Uuid
  rejectedAt              DateTime?
  rejectionReason         String?           @db.Text
  errorMessage            String?           @db.Text
  tokensUsed              Int?
  durationMs              Int?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  org                  Org                 @relation(fields: [orgId], references: [id])
  workOrder            WorkOrder           @relation(fields: [workOrderId], references: [id])
  procedureTemplate    ProcedureTemplate?  @relation(fields: [procedureTemplateId], references: [id])
  workflowDefinition   WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id])
  approvedBy           User?               @relation("AITaskPlanApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, workOrderId])
  @@index([workOrderId])
  @@index([status])
}
